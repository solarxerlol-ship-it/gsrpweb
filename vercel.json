{
  "version": 2,
  "builds": [
    {
      "src": "server/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["public/**", "server/**"]
      }
    }
  ],
  "rewrites": [
    { "source": "/",          "destination": "/public/index.html" },
    { "source": "/map",       "destination": "/public/map.html" },
    { "source": "/map.html",  "destination": "/public/map.html" },
    { "source": "/shop",      "destination": "/public/shop.html" },
    { "source": "/shop.html", "destination": "/public/shop.html" },
    { "source": "/apply",     "destination": "/public/apply.html" },
    { "source": "/apply.html","destination": "/public/apply.html" },
    { "source": "/(.*)",      "destination": "/server/index.js" }
  ]
}
